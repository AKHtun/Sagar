#!/bin/sh
# pre-push guard for release tags.
#
# Git has no hook that fires when a tag is *created* locally, so release
# tags are validated here, before they leave the machine: every push of
# refs/tags/v* is checked against the version files recorded in the
# tagged commit itself (not the working tree).
#
# Install with: bun run hooks:install
# Bypass only to delete a bad tag: git push origin :refs/tags/vX.Y.Z

set -u

ZERO="0000000000000000000000000000000000000000"
failed=0

while read -r local_ref local_sha remote_ref _remote_sha; do
  case "${remote_ref:-}" in
    refs/tags/v*) ;;
    *) continue ;;
  esac
  # Tag deletion: nothing to validate.
  if [ "$local_sha" = "$ZERO" ]; then
    continue
  fi
  tag="${remote_ref#refs/tags/}"

  if ! command -v bun >/dev/null 2>&1; then
    echo "pre-push: 'bun' not found in PATH; cannot verify release tag $tag" >&2
    failed=1
    continue
  fi

  root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "pre-push: cannot locate repo root" >&2
    failed=1
    continue
  }

  if ! bun "$root/scripts/release-version.ts" check --tag "$tag" --ref "$local_sha"; then
    echo "pre-push: blocked push of $remote_ref (fix versions, amend, move the tag)" >&2
    failed=1
  fi
done

exit "$failed"
